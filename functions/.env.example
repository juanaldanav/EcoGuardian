# ============================================================
#   functions/.env.example
#   Variables requeridas para envío de correo.
#   NUNCA guardar credenciales reales aquí.
#   Configurar con: firebase functions:secrets:set NOMBRE_VAR
# ============================================================

SMTP_HOST=smtp.tuproveedor.com
SMTP_PORT=587
SMTP_USER=tu_usuario@correo.com
SMTP_PASS=tu_contraseña
SMTP_FROM=alertas@tudominio.com
ALERT_TO=destinatario@correo.com
